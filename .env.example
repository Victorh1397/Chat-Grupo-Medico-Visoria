# Copiar a .env y rellenar. El .env NO se sube al repositorio.

# Gemini (Google AI Studio -> Get API key)
GOOGLE_API_KEY=

# Proyecto de Google Cloud donde vive el agente Dialogflow ES
DIALOGFLOW_PROJECT_ID=

# Solo si se usa cuenta de servicio en lugar de ADC (gcloud auth application-default login)
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/fuera/del/repo/clave.json

# Extra Telegram (opcional): IDs de usuario permitidos, separados por comas
# TELEGRAM_USUARIOS_PERMITIDOS=
